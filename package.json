{
  "name": "presenter-orbit",
  "version": "0.0.1-alpha.1",
  "description": "Presenter Orbit - modular presentation control app",
  "scripts": {
    "postinstall": "npm run proto:prepare",
    "proto:prepare": "node scripts/prepare-propresenter-proto.mts",
    "version": "node scripts/sync-app-version.mts",
    "start": "cargo run -p orbit-app",
    "dev": "cargo run -p orbit-app",
    "dev:hot": "node scripts/dev-hot.mts",
    "dev:hot:setup": "node scripts/dev-hot.mts --setup",
    "check": "npm run maintenance:check && npm run format:check && node scripts/check-syntax.cts && cargo fmt --all --check && node scripts/check-clippy.mts",
    "verify": "npm run check && npm run test",
    "maintenance:check": "node scripts/check-toolchain-config.mts && node scripts/check-workflow-action-pins.mts && node scripts/check-architecture-boundaries.mts && node scripts/check-i18n.mts && node scripts/check-versions.mts && node scripts/check-workspace-compatibility.mts",
    "format": "prettier --write \"scripts/**/*.{cts,mts}\" \"*.json\"",
    "format:check": "prettier --check \"scripts/**/*.{cts,mts}\" \"*.json\"",
    "test": "npm run test:e2e",
    "workspace:release-check": "node scripts/check-workspace-compatibility.mts --release",
    "package:companion": "npm --prefix integrations/companion-orbit run package",
    "package:streamdeck": "npm --prefix integrations/streamdeck-orbit run package",
    "release:evidence": "node scripts/write-release-evidence.mts",
    "i18n:metadata": "node scripts/fill-i18n-metadata.cts",
    "build": "npm run package:gpui:windows",
    "package:gpui:windows": "node scripts/package-gpui.mts --platform windows",
    "package:gpui:macos": "node scripts/package-gpui.mts --platform macos",
    "package:gpui:linux": "node scripts/package-gpui.mts --platform linux",
    "gpui:smoke": "node scripts/gpui-smoke.mts",
    "test:e2e": "node scripts/test-e2e.mts"
  },
  "keywords": [
    "presenter",
    "presentation",
    "worship",
    "slides"
  ],
  "author": {
    "name": "Orvion Lab",
    "email": "info@orvionlab.com"
  },
  "license": "GPL-3.0-only",
  "engines": {
    "node": "26.5.1",
    "npm": "12.0.2"
  },
  "packageManager": "npm@12.0.2",
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
