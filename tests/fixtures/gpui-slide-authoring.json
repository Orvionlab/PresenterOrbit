[
  {
    "name": "an inherited text edit stores only its changed style and local content",
    "kind": "store",
    "source": {
      "id": "slide",
      "content": "Old",
      "primaryTextLayerId": "text"
    },
    "theme": {
      "id": "layout",
      "width": 1000,
      "height": 600,
      "background": "#000000",
      "layers": [
        {
          "id": "text",
          "type": "Text",
          "role": "primary",
          "bounds": {
            "x": 10,
            "y": 10,
            "width": 980,
            "height": 580
          },
          "textStyle": {
            "fontFamily": "Arial",
            "fontSize": 40
          }
        }
      ]
    },
    "changes": {
      "content": "New",
      "contentRuns": [
        {
          "text": "N",
          "style": {
            "bold": true
          }
        },
        {
          "text": "ew"
        }
      ]
    },
    "layerChanges": {
      "text": {
        "text": "New",
        "textStyle": {
          "fontFamily": "Arial",
          "fontSize": 50
        }
      }
    },
    "expected": {
      "id": "slide",
      "content": "New",
      "primaryTextLayerId": "text",
      "contentRuns": [
        {
          "text": "N",
          "style": {
            "bold": true
          }
        },
        {
          "text": "ew"
        }
      ],
      "themeLayerOverrides": {
        "text": {
          "textStyle": {
            "fontSize": 50
          }
        }
      },
      "themeLayerOrder": [
        "text"
      ],
      "layers": []
    }
  },
  {
