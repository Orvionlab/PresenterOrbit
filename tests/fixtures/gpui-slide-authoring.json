          "textStyle": {
            "fontFamily": "Roboto"
          }
        }
      ],
      "notes": "A\nB\nC",
      "notesRuns": [
        {
          "text": "A\nB\nC"
        }
      ],
      "notesTextStyle": {
        "textParagraphStyles": [
          {
            "textHorizontalAlign": "left"
          },
