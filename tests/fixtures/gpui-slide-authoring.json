  {
    "name": "notes keep their decorations and paragraph styles through an inserted paragraph",
    "kind": "notes",
    "source": {
      "id": "slide",
      "width": 1920,
      "height": 1080,
      "content": "Hello",
      "primaryTextLayerId": "local",
