  {
    "name": "mixed fonts and emoji commit as explicit primary text runs",
    "kind": "text",
    "source": {
      "id": "slide",
      "width": 1920,
      "height": 1080,
      "content": "Hello",
      "primaryTextLayerId": "local",
      "layers": [
        {
          "id": "local",
          "type": "Text",
          "role": "primary",
          "text": "Hello",
          "textStyle": {
            "fontFamily": "Roboto"
          }
        }
      ]
    },
    "runs": [
      {
        "text": "Hé",
        "style": {
          "fontFamily": "Arial",
          "fontSize": 48,
          "bold": true
        }
      },
      {
        "text": " 🎵",
        "style": {
          "italic": true,
          "underline": true,
          "textColor": "#112233"
        }
      }
    ],
    "expected": {
      "id": "slide",
      "width": 1920,
      "height": 1080,
      "content": "Hé 🎵",
      "primaryTextLayerId": "local",
      "layers": [
        {
          "id": "local",
          "type": "Text",
          "role": "primary",
          "text": "Hé 🎵",
          "textStyle": {
            "fontFamily": "Roboto"
          },
          "textRuns": [
            {
              "text": "Hé",
              "style": {
                "fontFamily": "Arial",
                "fontSize": 48,
                "bold": true
              }
            },
            {
              "text": " 🎵",
              "style": {
                "italic": true,
                "underline": true,
                "textColor": "#112233"
              }
            }
          ]
        }
      ],
      "contentRuns": [
        {
          "text": "Hé",
          "style": {
            "fontFamily": "Arial",
            "fontSize": 48,
            "bold": true
          }
        },
        {
          "text": " 🎵",
          "style": {
            "italic": true,
            "underline": true,
            "textColor": "#112233"
          }
        }
      ]
    }
  },
