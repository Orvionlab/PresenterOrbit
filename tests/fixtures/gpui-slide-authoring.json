      "layers": [
        {
          "id": "local",
          "type": "Text",
          "role": "primary",
          "text": "Hello",
          "textStyle": {
            "fontFamily": "Roboto"
          }
        }
      ],
      "notes": "A\nNew\nB\nC",
      "notesRuns": [
        {
          "text": "A\nNew\n",
          "style": {
            "letterSpacing": 2,
            "superscript": -1,
            "underline": true,
            "underlineStyle": "double",
            "underlinePattern": "dash-dot",
            "underlineByWord": true,
            "underlineColor": "#ff0000",
            "strikethrough": true,
            "strikethroughStyle": "thick",
            "strikethroughPattern": "dot",
            "strikethroughByWord": false,
            "strikethroughColor": "#00ff00"
          }
        },
        {
          "text": "B\nC"
        }
      ],
      "notesTextStyle": {
        "textParagraphStyles": [
          {
            "textHorizontalAlign": "left"
          },
          {
            "textHorizontalAlign": "left"
          },
          {
            "textHorizontalAlign": "center"
          },
          {
            "textHorizontalAlign": "right"
          }
        ]
      }
    }
  },
