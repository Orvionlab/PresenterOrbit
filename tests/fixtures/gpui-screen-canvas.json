[
  {
    "name": "independent output",
    "configs": {
      "a": {
        "type": "audience"
      }
    },
    "error": null
  },
  {
    "name": "bounded source canvas",
    "configs": {
      "a": {
        "type": "audience",
        "canvasSize": {
          "width": 3840,
          "height": 1080
        }
      }
    },
    "error": null
  },
  {
    "name": "a tile stays within the source canvas",
    "configs": {
      "a": {
        "type": "audience",
        "canvasSize": {
          "width": 3840,
          "height": 1080
        }
      },
      "b": {
        "type": "audience",
        "canvasView": {
          "sourceScreenId": "a",
          "region": {
            "x": 1920,
            "y": 0,
            "width": 1920,
            "height": 1080
          }
        }
      }
    },
    "error": null
  },
  {
    "name": "mirror does not require a declared source canvas",
    "configs": {
      "a": {
        "type": "audience"
      },
      "b": {
        "type": "audience",
        "canvasView": {
          "sourceScreenId": "a"
        }
      }
    },
    "error": null
  },
  {
    "name": "self mirrors are invalid",
    "configs": {
      "a": {
        "type": "audience",
        "canvasView": {
          "sourceScreenId": "a"
        }
      }
    },
    "error": "screenSettings.canvas.invalidSource"
  },
  {
    "name": "mirrors cannot chain",
    "configs": {
      "a": {
        "type": "audience"
      },
      "b": {
        "type": "audience",
        "canvasView": {
          "sourceScreenId": "a"
        }
      },
      "c": {
        "type": "audience",
        "canvasView": {
          "sourceScreenId": "b"
        }
      }
    },
    "error": "screenSettings.canvas.invalidSource"
  },
  {
    "name": "stage and audience cannot mirror each other",
    "configs": {
      "a": {
        "type": "stage"
      },
      "b": {
        "type": "audience",
        "canvasView": {
          "sourceScreenId": "a"
        }
      }
    },
    "error": "screenSettings.canvas.invalidSource"
  },
  {
    "name": "canvas pixels are bounded",
    "configs": {
      "a": {
        "type": "audience",
        "canvasSize": {
          "width": 8192,
          "height": 8192
        }
      }
    },
    "error": "screenSettings.canvas.invalidSize"
  },
  {
    "name": "fractional canvas dimensions are invalid",
    "configs": {
      "a": {
        "type": "audience",
        "canvasSize": {
          "width": 1920.5,
          "height": 1080
        }
      }
    },
    "error": "screenSettings.canvas.invalidSize"
  },
  {
    "name": "tile needs an explicit source canvas",
    "configs": {
      "a": {
        "type": "audience"
      },
      "b": {
        "type": "audience",
        "canvasView": {
          "sourceScreenId": "a",
          "region": {
            "x": 0,
            "y": 0,
            "width": 100,
            "height": 100
          }
        }
      }
    },
    "error": "screenSettings.canvas.invalidRegion"
  },
  {
    "name": "tile overhang is rejected",
    "configs": {
      "a": {
        "type": "audience",
        "canvasSize": {
          "width": 3840,
          "height": 1080
        }
      },
      "b": {
        "type": "audience",
        "canvasView": {
          "sourceScreenId": "a",
          "region": {
            "x": 3000,
            "y": 0,
            "width": 1000,
            "height": 1080
          }
        }
      }
    },
    "error": "screenSettings.canvas.invalidRegion"
  },
  {
    "name": "tile origin must be a whole nonnegative pixel",
    "configs": {
      "a": {
        "type": "audience",
        "canvasSize": {
          "width": 3840,
          "height": 1080
        }
      },
      "b": {
        "type": "audience",
        "canvasView": {
          "sourceScreenId": "a",
          "region": {
            "x": 0.5,
            "y": 0,
            "width": 1920,
            "height": 1080
          }
        }
      }
    },
    "error": "screenSettings.canvas.invalidRegion"
  },
  {
    "name": "an output cannot own and view a canvas simultaneously",
    "configs": {
      "a": {
        "type": "audience",
        "canvasSize": {
          "width": 100,
          "height": 100
        },
        "canvasView": {
          "sourceScreenId": "b"
        }
      },
      "b": {
        "type": "audience"
      }
    },
    "error": "screenSettings.canvas.invalidSize"
  }
]
